{
  "name": "dss-template-repo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "mcp": "npx -y supergateway --port 8001 --stdio \"npx @modelcontextprotocol/server-sequential-thinking\"",
    "mcp-custom": "npx -y supergateway --port 8002 --stdio \"python src/rules_injector_server.py\"",
    "start:rules-injector": "npx -y supergateway --port 8002 --stdio \"python src/rules_injector_server.py\"",
    "start:rules-injector:debug": "DEBUG=supergateway* npx -y supergateway --logLevel debug --stdio \"python src/rules_injector_server.py\"",
    "start:sequential": "cd node_modules/@modelcontextprotocol/server-sequential-thinking && node dist/index.js",
    "build:sequential": "cd node_modules/@modelcontextprotocol/server-sequential-thinking && npm run build",
    "test:word": "powershell -ExecutionPolicy Bypass -File tools/run-word-autotest.ps1",
    "test:mock": "mocha tests/mock --recursive"
  },
  "dependencies": {
    "@modelcontextprotocol/server-sequential-thinking": "latest",
    "jq": "^1.7.2",
    "office-addin-mock": "^3.0.3",
    "pytest": "^1.0.0",
    "trio": "^0.2.13"
  },
  "devDependencies": {
    "@types/node": "^20.11.9",
    "@vscode/vsce": "^2.24.0",
    "chai": "^4.3.8",
    "mocha": "^10.4.0",
    "office-addin-dev-certs": "^1.5.0",
    "office-addin-dev-settings": "^1.9.2",
    "office-addin-test-helpers": "^2.0.3",
    "office-addin-test-server": "^0.3.0",
    "shx": "^0.3.4",
    "typescript": "^5.5.0"
  }
}
