{
    "compilerOptions": {
      "target": "ES2020",
      "module": "ESNext",
      "moduleResolution": "bundler",
      "esModuleInterop": true,
      "strict": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "outDir": "dist",
      "rootDir": ".",
      "allowJs": true,
      "resolveJsonModule": true,
      "types": ["node"]
    },
    "include": ["src/**/*", "meta/**/*"],
    "exclude": ["node_modules"]
  }
  