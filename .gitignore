review-gate-v2/

# Compiled Python artifacts
# These are generated by Python and don't need to be tracked.
# They can be recreated from source code.
__pycache__/
*.pyc
*.pyd
*.pyo

# Node.js / JavaScript build artifacts and dependencies
# `node_modules` contains all your project's dependencies, which are
# usually downloaded when someone clones the repo and runs `npm install`.
# `dist/` is a common directory for compiled or bundled code ready for distribution.
node_modules/
dist/
npm-debug.log* # Logs from npm, not source code.

# Environment variables
# These often contain sensitive information (API keys, passwords) or
# local configuration that shouldn't be shared in version control.
.env
.env.*local # Common pattern for local-specific environment files

# IDE / Editor specific files and temporary testing environments
# Your log showed a massive `vscode-test` directory containing `Code.exe`
# and many other files. This is a local testing environment for VS Code extensions
# and should absolutely not be committed.
.vscode-test/
# You might also want to ignore general .vscode/ settings if they are user-specific,
# but often .vscode/ settings are shared for team consistency.
# If you have a .vscode/ directory, consider adding:
# .vscode/
# ... and then specifically un-ignoring files you *do* want to track, like:
# !.vscode/settings.json
# !.vscode/tasks.json
# !.vscode/launch.json

# Backup and temporary files
# Files created by editors or systems as temporary backups.
# `* copy.*` covers things like `complete copy.md`.
# `~*` covers temporary files often created by Word or other applications.
*.backup
* copy.*
~*
*.tmp
*.swp # Vim swap files
*.swo # Vim swap files

# Test and Log output
# Results from automated tests or general application logs.
# These are generated and change frequently, bloating history.
qr_autotest_results.json
*.log

# Compiled binaries / Distribution files
# These are executables or packaged applications that can be built from source.
# The `Code.exe` that caused your push to fail falls into this category.
table_formatter/.vscode-test/vscode-win32-x64-archive-1.102.0/Code.exe
*.vsix
# If you have other executables or binaries that are *not* handled by Git LFS
# and are not source code, you might add their extensions here:
# *.exe
# *.dll
# *.bin

# Nested Git repositories
# Your log indicated `Review-Gate` was opened as a separate repository.
# If `Review-Gate` is meant to be a separate Git repository (e.g., a submodule)
# it should be handled as such. If it's just a regular directory that accidentally
# got a `.git` folder inside, ignoring it prevents the parent repo from tracking it.
# If it's a submodule, you'd typically track the submodule reference, not its contents.
Review-Gate/
